NODE_ENV=development
PORT=3001
POSTGRES_USER=safeops
POSTGRES_PASSWORD=safeops_dev_password
POSTGRES_DB=safeops
DATABASE_URL=postgres://safeops:safeops_dev_password@localhost:5432/safeops
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ALERT_API_KEY=replace-with-at-least-32-random-characters-api-key
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=uploads
SLA_CHECK_INTERVAL_SECONDS=30
