commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Pattern: <type>(<scope>): <description>
# Cho phép có hoặc không có [Task-ID] trong mô tả
pattern='^(feat|fix|chore|docs|style|refactor|test|perf|ci|build|revert)(\(.+\))?: .{1,150}$'

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "❌  Commit message không đúng chuẩn SafeOps!"
  echo ""
  echo "   Format:  <type>(<scope>): [<Task-ID>] <mô tả>"
  echo "   Ví dụ:   chore(infra): [M0-10] setup ESLint, Prettier và Husky"
  echo "            feat(auth): [M1-05] implement JWT login endpoint"
  echo "            fix(incident): [M2-03] handle transaction rollback"
  echo ""
  echo "   Types:   feat | fix | chore | docs | style | refactor | test | perf | ci | build | revert"
  echo ""
  exit 1
fi
