{
  "name": "safeops",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"{backend,frontend}/**/*\" \"*.{js,cjs,mjs,json,jsonc,yml,yaml}\" README.md --ignore-unknown --no-error-on-unmatched-pattern --write",
    "format:check": "prettier \"{backend,frontend}/**/*\" \"*.{js,cjs,mjs,json,jsonc,yml,yaml}\" README.md --ignore-unknown --no-error-on-unmatched-pattern --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
