{
  "name": "safeops-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint:backend": "eslint \"backend/src/**/*.ts\" -c backend/.eslintrc.json --resolve-plugins-relative-to . --no-error-on-unmatched-pattern --fix",
    "lint:frontend": "eslint \"frontend/src/**/*.{ts,tsx}\" -c frontend/.eslintrc.json --resolve-plugins-relative-to . --no-error-on-unmatched-pattern --fix",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "backend/src/**/*.{ts,js}": [
      "prettier --write"
    ],
    "frontend/src/**/*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write --ignore-path .prettierignore"
    ]
  }
}
